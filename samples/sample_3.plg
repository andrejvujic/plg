function pow(int num, int exp) -> int {
    int result = 1;
    int j;
    for (j = 0; j < exp; j = j + 1)
        result = result * num;
    return result;
} 

function upow(uint num, int exp) -> uint {
    uint result = 1u;
    int j;
    for (j = 0; j < exp; j = j + 1)
        result = result * num;
    return result;
}

int a = pow(2, 5);
uint b = upow(2u, 5);